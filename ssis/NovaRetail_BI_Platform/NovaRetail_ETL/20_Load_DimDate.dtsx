    <DTS:Executable
      DTS:refId="Package\SQL_Load_DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{25C3873C-3FAF-4847-B213-A3C1FBA541DB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{58D8B162-D583-4C79-988B-FD28109D0599}"
          SQLTask:SqlStatementSource=";WITH DateSeries AS&#xA;(&#xA;    SELECT CAST('2023-01-01' AS DATE) AS FullDate&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(DAY, 1, FullDate)&#xA;    FROM DateSeries&#xA;    WHERE FullDate &lt; '2026-12-31'&#xA;)&#xA;INSERT INTO dbo.DimDate&#xA;(&#xA;    DateKey,&#xA;    FullDate,&#xA;    DayNumber,&#xA;    DayName,&#xA;    DayOfWeek,&#xA;    WeekNumber,&#xA;    MonthNumber,&#xA;    MonthName,&#xA;    YearMonth,&#xA;    QuarterNumber,&#xA;    QuarterName,&#xA;    YearNumber,&#xA;    IsWeekend&#xA;)&#xA;SELECT&#xA;    CAST(CONVERT(CHAR(8), FullDate, 112) AS INT),&#xA;&#xA;    FullDate,&#xA;&#xA;    DAY(FullDate),&#xA;&#xA;    DATENAME(WEEKDAY, FullDate),&#xA;&#xA;    DATEPART(WEEKDAY, FullDate),&#xA;&#xA;    DATEPART(ISO_WEEK, FullDate),&#xA;&#xA;    MONTH(FullDate),&#xA;&#xA;    DATENAME(MONTH, FullDate),&#xA;&#xA;    CONVERT(CHAR(7), FullDate, 120),&#xA;&#xA;    DATEPART(QUARTER, FullDate),&#xA;&#xA;    CONCAT('Q', DATEPART(QUARTER, FullDate)),&#xA;&#xA;    YEAR(FullDate),&#xA;&#xA;    CASE&#xA;        WHEN DATENAME(WEEKDAY, FullDate)&#xA;             IN ('Saturday', 'Sunday')&#xA;        THEN 1&#xA;        ELSE 0&#xA;    END&#xA;FROM DateSeries AS d&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.DimDate existing&#xA;    WHERE existing.DateKey =&#xA;          CAST(CONVERT(CHAR(8), d.FullDate, 112) AS INT)&#xA;)&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
